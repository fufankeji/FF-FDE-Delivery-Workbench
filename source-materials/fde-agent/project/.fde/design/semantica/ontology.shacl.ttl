    ] .

<https://semantica.dev/shapes/DataSourceShape>
    a sh:NodeShape ;
    sh:targetClass <https://fde.local/ontology/DataSource> ;
    sh:name "证据来源" ;
    sh:property [
        sh:path <https://fde.local/ontology/source_id> ;
        sh:datatype xsd:xsd:string ;
