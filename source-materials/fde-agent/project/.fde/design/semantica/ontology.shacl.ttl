    ] ;
    sh:property [
        sh:path <https://fde.local/ontology/rel_vendor_contract> ;
        sh:class <https://fde.local/ontology/Contract> ;
        sh:severity sh:Violation
    ] .

<https://semantica.dev/shapes/PrincipalShape>
