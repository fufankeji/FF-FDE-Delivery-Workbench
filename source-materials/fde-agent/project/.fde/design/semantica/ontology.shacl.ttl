    a sh:NodeShape ;
    sh:targetClass <https://fde.local/ontology/Contract> ;
    sh:name "合同候选" ;
    sh:property [
        sh:path <https://fde.local/ontology/contract_id> ;
        sh:datatype xsd:xsd:string ;
        sh:minCount 1 ;
        sh:severity sh:Violation
    ] .

<https://semantica.dev/shapes/VendorShape>
    a sh:NodeShape ;
    sh:targetClass <https://fde.local/ontology/Vendor> ;
    sh:name "维修商" ;
    sh:property [
        sh:path <https://fde.local/ontology/vendor_id> ;
