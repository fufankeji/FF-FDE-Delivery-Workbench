<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title }} · v{{ version }}</title>
  <style>
    :root { --ink:#201b17; --muted:#75695e; --paper:#f8f2e9; --line:#dfd1c0; --copper:#bb6828; --cream:#fffaf3; }
    * { box-sizing: border-box; }
    body { margin:0; color:var(--ink); background:var(--paper); font:16px/1.72 Inter,system-ui,sans-serif; }
    .page { position:relative; max-width:1120px; min-height:100vh; margin:0 auto; padding:62px 72px 120px; overflow:hidden; }
    .brand { display:flex; justify-content:space-between; padding-bottom:18px; border-bottom:1px solid var(--line); color:var(--copper); letter-spacing:.08em; font-size:12px; text-transform:uppercase; }
    h1,h2,h3 { font-family:"Iowan Old Style",Georgia,serif; line-height:1.15; }
    h1 { max-width:850px; font-size:52px; margin:54px 0 20px; letter-spacing:-.025em; } h2 { font-size:30px; margin-top:58px; border-top:1px solid var(--line); padding-top:24px; }
    h3 { font-size:22px; } p,li { max-width:74ch; } blockquote { border-left:3px solid var(--copper); margin:24px 0; padding:8px 20px; color:var(--muted); }
    .report-table-frame { max-width:100%; margin:24px 0; overflow:hidden; border:1px solid var(--line); border-radius:8px; background:rgb(255 255 255 / 42%); }
    .report-table-hint { display:none; justify-content:flex-end; padding:7px 12px; border-bottom:1px solid var(--line); color:var(--copper); background:#f3e7d8; font-size:11px; }
    .report-table-frame.is-overflowing .report-table-hint { display:flex; }
    .report-table-scroll { max-width:100%; overflow-x:auto; overscroll-behavior-inline:contain; }
    table { width:max-content; min-width:100%; border-collapse:collapse; margin:0; background:transparent; }
    th,td { padding:12px 14px; text-align:left; border-bottom:1px solid var(--line); } th { color:var(--copper); }
    .report-table-scroll th,.report-table-scroll td { min-width:118px; max-width:260px; vertical-align:top; overflow-wrap:anywhere; }
    code { font-family:ui-monospace,SFMono-Regular,monospace; background:#e9dece; padding:2px 5px; border-radius:4px; }
    pre { overflow:auto; padding:18px; background:#171513; color:#f4eee5; border-radius:10px; }
    pre code { background:transparent; padding:0; }
    .mountain { position:absolute; right:-70px; bottom:-30px; width:68%; opacity:.24; pointer-events:none; }
    .content { position:relative; z-index:1; }
    .visuals { position:relative; z-index:1; margin-top:52px; }
    .visual-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:22px; }
    .visual-card { margin:0; padding:22px 0 26px; border-top:2px solid var(--copper); background:transparent; }
    .visual-card__meta { display:flex; justify-content:space-between; gap:16px; margin-bottom:8px;
      color:var(--muted); font-size:12px; }
    .visual-card__meta code { background:transparent; padding:0; }
    .chart { width:100%; height:360px; }
    .chart-fallback { padding:18px; border-left:3px solid var(--copper); color:var(--muted); }
    @media (max-width:860px) { .page { padding:42px 28px 90px; } .visual-grid { grid-template-columns:1fr; } }
    @media print { body { background:white; } .page { margin:0; max-width:none; } .report-table-hint { display:none !important; } .report-table-scroll { overflow:visible; } table { width:100%; table-layout:fixed; font-size:10px; } }
  </style>
</head>
<body>
  <main class="page">
    <div class="brand"><span>DS4 · AI Analysis Report</span><span>Version {{ version }}</span></div>
    <article class="content">{{ body | safe }}</article>
    {% if charts %}
    <section class="visuals">
      <h2>交互图表</h2>
      <div class="visual-grid">
      {% for chart in charts %}
      <figure class="visual-card">
        <figcaption class="visual-card__meta">
          <span>{{ chart.title }}</span><span>{{ chart.source_name }}</span>
        </figcaption>
        <div id="{{ chart.element_id }}" class="chart"></div>
      </figure>
      {% endfor %}
      </div>
    </section>
    {% endif %}
    {% if mountain_data %}<img class="mountain" alt="" src="data:image/png;base64,{{ mountain_data }}">{% endif %}
  </main>
  <script>
    const syncReportTableOverflow = () => document.querySelectorAll(".report-table-frame").forEach((frame) => {
      const scroller = frame.querySelector(".report-table-scroll");
      frame.classList.toggle("is-overflowing", scroller.scrollWidth > scroller.clientWidth + 1);
    });
    requestAnimationFrame(syncReportTableOverflow);
    addEventListener("resize", syncReportTableOverflow);
  </script>
  {% if charts and echarts_js %}
  <script>{{ echarts_js | safe }}</script>
  <script>
    const reportChartOptions = {{ chart_options | tojson }};
    const reportCharts = Object.entries(reportChartOptions).map(([id, option]) => {
      const instance = echarts.init(document.getElementById(id), null, { renderer: "svg" });
      instance.setOption(option);
      return instance;
    });
    addEventListener("resize", () => reportCharts.forEach((chart) => chart.resize()));
  </script>
  {% elif charts %}
  <script>
    document.querySelectorAll(".chart").forEach((node) => {
      node.className = "chart-fallback";
      node.textContent = "交互图表运行库未安装；证据表和图表产物标识仍保留在报告中。";
    });
  </script>
  {% endif %}
</body>
</html>
